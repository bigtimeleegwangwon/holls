# data/ 디렉토리 직접 접근 차단
<Directory "data">
  Deny from all
</Directory>

# lib/ 디렉토리 직접 접근 차단
<Directory "lib">
  Deny from all
</Directory>

# config 파일 접근 차단
<Files "config.php">
  Deny from all
</Files>
<Files "config.local.php">
  Deny from all
</Files>

# 모든 요청을 index.php로 라우팅
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /sholl_api/

  # 실제 파일/디렉토리는 pass through
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # 나머지는 index.php로 라우팅
  RewriteRule ^(.*)$ index.php [L,QSA]
</IfModule>
